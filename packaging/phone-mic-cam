#!/bin/sh
# Launcher installed as /usr/bin/phone-mic-cam.
# Started from the app grid there's no terminal, so ask the app to keep this
# run's output in a log file for troubleshooting. The app opens it itself,
# and only once it knows it's the copy that starts: opening the app again
# while it runs (to reopen the control page) must not wipe the running
# copy's log.
if [ ! -t 1 ]; then
    set -- --log-file "${XDG_STATE_HOME:-$HOME/.local/state}/phone-mic-cam/last-run.log" "$@"
fi
exec python3 -u /usr/share/phone-mic-cam/phone_mic_cam.py "$@"
